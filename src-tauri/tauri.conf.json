{
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "GiccooBox",
        "version": "0.1.0"
    },
    "tauri": {
        "allowlist": {
            "all": true,
            "http": {
                "all": true,
                "scope": ["https://*"]
            },
            "shell": {
                "all": false,
                "open": true
            }
        },
        "windows": [
            {
                "title": "GiccooBox",
                "width": 900,
                "height": 600
            }
        ],
        "security": {
            "csp": null,
            "dangerousRemoteDomainIpcAccess": [
                {
                    "domain": "live.douyin.com",
                    "windows": ["previewWeb", "douyinLogin"],
                    "enableTauriAPI": true
                }
            ]
        },
        "bundle": {
            "active": true,
            "targets": "all",
            "identifier": "com.live.box",
            "resources": ["scripts/tiktok_bridge.py"],
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ]
        }
    }
}
